# NYT API Key (required for ingestion)
# Get one at https://developer.nytimes.com/
NYT_API_KEY=your_nyt_api_key_here

# OpenAI API Key (optional — only needed for theme labeling/merge/RBICS mapping)
# The entire non-LLM pipeline works without this.
OPENAI_API_KEY=

# Database path (default: data/nyt_pipeline.duckdb)
DB_PATH=data/nyt_pipeline.duckdb

# Supabase / PostgreSQL connection string (optional — for exporting data)
# Example: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=

# Embedding model backend: "local" or "openai" (default: local)
EMBEDDING_BACKEND=local

# Local embedding model name (sentence-transformers)
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# OpenAI embedding model (only used if EMBEDDING_BACKEND=openai)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OpenAI chat model for sparse labeling
OPENAI_CHAT_MODEL=gpt-4o-mini

# Rate limiting defaults
NYT_REQUESTS_PER_MINUTE=3
NYT_ARCHIVE_DAILY_BUDGET=1500
NYT_ARTICLE_SEARCH_DAILY_BUDGET=500
NYT_CONCURRENCY=1
NYT_MAX_RETRIES=5

# Clustering
CLUSTERING_MIN_CLUSTER_SIZE=5
CLUSTERING_MIN_SAMPLES=3
THEME_SIMILARITY_THRESHOLD=0.65
THEME_MERGE_THRESHOLD=0.80

# Logging level
LOG_LEVEL=INFO
